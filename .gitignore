# Visual Studio / Rider
.vs/
**/.vs/
.idea/
**/.idea/

# Visual Studio 2015 user specific files

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.pdb
*.exp

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/
**/Binaries/
Plugins/**/Binaries/

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/
**/Saved/

# Compiled source files for the engine to use
Intermediate/
**/Intermediate/
Plugins/**/Intermediate/

# Cache files for the editor to use
DerivedDataCache/
**/DerivedDataCache/

# Source FBX (imported to Content as uassets)
Raw/

# Paragon animation pack (~3.7GB). Keep local; use LFS or Drive if you need to share it.
MobaProject/Content/ParagonAnims/

# Editor automation / local-only
MobaProject/Tools/
MobaProject/.mcp.json
MobaProject/Content/Developers/
MobaProject/Packaged/
*.zip

# Epic template leftovers (do not re-add)
MobaProject/Content/ThirdPerson/
MobaProject/Content/Variant_Combat/
MobaProject/Content/Variant_Platforming/
MobaProject/Content/Variant_SideScroller/
MobaProject/Content/__ExternalActors__/ThirdPerson/
MobaProject/Content/__ExternalActors__/Variant_Combat/
MobaProject/Content/__ExternalActors__/Variant_Platforming/
MobaProject/Content/__ExternalActors__/Variant_SideScroller/
